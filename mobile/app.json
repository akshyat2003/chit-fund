{
  "expo": {
    "name": "ChitKart",
    "slug": "chitkart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apexchits.management",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app requires access to the camera to capture payment receipt photos.",
        "NSPhotoLibraryUsageDescription": "This app requires access to the photo library to select payment receipt screenshots."
      }
    },
    "android": {
      "package": "com.apexchits.management",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A2540"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/23d28189-83c0-45c9-bc4d-b808bbc344c8",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "jsEngine": "hermes",
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to allow you to upload payment receipts and screenshots.",
          "cameraPermission": "The app accesses your camera to capture payment receipt photos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; } -dontwarn com.facebook.react.**"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "23d28189-83c0-45c9-bc4d-b808bbc344c8"
      }
    },
    "owner": "akshyat2003"
  }
}
