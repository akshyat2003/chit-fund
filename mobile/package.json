{
  "name": "chit-fund-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "build": "expo export -p web",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:prod": "eas build -p android --profile production-apk",
    "build:android": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile production",
    "build:ios:simulator": "eas build -p ios --profile preview",
    "build:all": "eas build --all --profile production",
    "update": "eas update --channel preview",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@tanstack/react-query": "^5.60.5",
    "axios": "^1.7.7",
    "expo": "~51.0.0",
    "expo-build-properties": "^0.12.5",
    "expo-image-picker": "~15.1.0",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-updates": "^0.25.28",
    "lucide-react-native": "^0.454.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.45",
    "eas-cli": "^24.14.0",
    "typescript": "~5.3.3"
  }
}
