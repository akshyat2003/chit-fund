// Prisma Schema for Chit Fund Management System (PostgreSQL / Supabase compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                    String   @id @default(uuid())
  code                  String   @unique
  name                  String
  stateRegistrationNo   String?
  address               String?
  phone                 String?
  email                 String?
  status                String   @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  branches              Branch[]
  users                 User[]
  subscribers           Subscriber[]
  chitGroups            ChitGroup[]
  transactions          PaymentTransaction[]
  auditLogs             AuditLog[]
}

model Branch {
  id          String   @id @default(uuid())
  companyId   String
  code        String   @unique
  name        String
  location    String?
  phone       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  subscribers Subscriber[]
  chitGroups  ChitGroup[]
  transactions PaymentTransaction[]
  handovers   CashHandover[]
  expenses    Expense[]
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  branchId     String?
  role         String   // SUPER_ADMIN, MANAGER, COLLECTION_STAFF
  username     String   @unique
  fullName     String
  phone        String   @unique
  email        String?
  passwordHash String
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch       Branch?  @relation(fields: [branchId], references: [id])
  
  assignedSubscribers Subscriber[] @relation("AssignedStaff")
  recordedTransactions PaymentTransaction[] @relation("RecordedBy")
  approvedPayouts     Payout[] @relation("ApprovedBy")
  submittedHandovers  CashHandover[] @relation("StaffHandover")
  verifiedHandovers   CashHandover[] @relation("ManagerVerification")
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
}

model Subscriber {
  id             String   @id @default(uuid())
  companyId      String
  branchId       String
  assignedStaffId String?
  subscriberCode String   @unique
  fullName       String
  phone          String   @unique
  email          String?
  address        String?
  dateOfBirth    String?
  kycStatus      String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  idProofType    String?  // AADHAAR, PAN, VOTER_ID, PASSPORT
  idProofNumber  String?
  nomineeName    String?
  nomineeRelation String?
  nomineePhone   String?
  status         String   @default("ACTIVE") // ACTIVE, SUSPENDED, DEACTIVATED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch         Branch   @relation(fields: [branchId], references: [id])
  assignedStaff  User?    @relation("AssignedStaff", fields: [assignedStaffId], references: [id])

  memberships    ChitGroupMember[]
  transactions   PaymentTransaction[]
  payouts        Payout[]
  auctionBids    AuctionBid[]
  auctionsWon    Auction[] @relation("AuctionWinner")
}

model ChitGroup {
  id                   String   @id @default(uuid())
  companyId            String
  branchId             String
  groupCode            String   @unique
  name                 String
  chitValue            Float    // Total Pool Amount e.g. 500000.00
  maxMembers           Int      // e.g. 20 members
  totalMonths          Int      // e.g. 20 months
  monthlyInstallment   Float    // Scheduled monthly installment e.g. 25000.00
  foremanCommissionPct Float    @default(5.0) // 5%
  startDate            String   // YYYY-MM-DD
  endDate              String?  // YYYY-MM-DD
  auctionFrequency     String   @default("MONTHLY") // MONTHLY
  status               String   @default("UPCOMING") // UPCOMING, ACTIVE, COMPLETED, CLOSED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch               Branch   @relation(fields: [branchId], references: [id])

  members              ChitGroupMember[]
  schedules            InstallmentSchedule[]
  transactions         PaymentTransaction[]
  auctions             Auction[]
}

model ChitGroupMember {
  id           String   @id @default(uuid())
  groupId      String
  subscriberId String
  ticketNumber Int      // Ticket number e.g. 1 to 20
  enrolledAt   DateTime @default(now())

  group        ChitGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([groupId, ticketNumber])
  @@unique([groupId, subscriberId])
}

model InstallmentSchedule {
  id              String   @id @default(uuid())
  groupId         String
  installmentNo   Int
  dueDate         String   // YYYY-MM-DD
  scheduledAmount Float
  dividendAmount  Float    @default(0.0)
  netDueAmount    Float    // scheduledAmount - dividendAmount
  createdAt       DateTime @default(now())

  group           ChitGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, installmentNo])
}

model PaymentTransaction {
  id                  String   @id @default(uuid())
  companyId           String
  branchId            String
  subscriberId        String
  groupId             String
  installmentNo       Int
  amount              Float
  paymentMode         String   // CASH, BANK_TRANSFER, UPI
  receiptNo           String   @unique
  externalRef         String?  // Bank / UPI Txn Reference ID
  recordedByUserId    String
  verificationStatus  String   @default("VERIFIED") // VERIFIED, PENDING_VERIFICATION, REJECTED, REVERSED
  isReversed          Boolean  @default(false)
  reversalReason      String?
  idempotencyKey      String?  @unique
  notes               String?
  createdAt           DateTime @default(now())

  company             Company    @relation(fields: [companyId], references: [id])
  branch              Branch     @relation(fields: [branchId], references: [id])
  subscriber          Subscriber @relation(fields: [subscriberId], references: [id])
  group               ChitGroup  @relation(fields: [groupId], references: [id])
  recordedBy          User       @relation("RecordedBy", fields: [recordedByUserId], references: [id])

  receipt             Receipt?
}

model Receipt {
  id            String   @id @default(uuid())
  transactionId String   @unique
  receiptNo     String   @unique
  printedCount  Int      @default(1)
  pdfPath       String?
  createdAt     DateTime @default(now())

  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Auction {
  id                   String   @id @default(uuid())
  groupId              String
  installmentNo        Int
  auctionDate          String   // YYYY-MM-DD
  winningBidDiscount   Float    // Bid discount given up by winner e.g. 50000.00
  foremanCommission    Float    // Commission kept by Foreman e.g. 25000.00 (5% of chit value)
  totalDividend        Float    // Distributable dividend (winningBidDiscount - foremanCommission)
  dividendPerMember    Float    // totalDividend / maxMembers
  winnerSubscriberId   String
  winningTicketNo      Int
  status               String   @default("CONFIRMED") // SCHEDULED, IN_PROGRESS, CONFIRMED, CANCELLED
  notes                String?
  createdAt            DateTime @default(now())

  group                ChitGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  winnerSubscriber     Subscriber @relation("AuctionWinner", fields: [winnerSubscriberId], references: [id])
  
  bids                 AuctionBid[]
  payout               Payout?

  @@unique([groupId, installmentNo])
}

model AuctionBid {
  id           String   @id @default(uuid())
  auctionId    String
  subscriberId String
  bidDiscount  Float
  bidTime      DateTime @default(now())

  auction      Auction    @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id])
}

model Payout {
  id                 String   @id @default(uuid())
  auctionId          String   @unique
  subscriberId       String
  grossBidAmount     Float    // Chit Value - winningBidDiscount
  deductions         Float    @default(0.0) // Any arrears/penalties
  netPayoutAmount    Float    // grossBidAmount - deductions
  paymentMode        String   @default("BANK_TRANSFER") // BANK_TRANSFER, CHEQUE, CASH
  transactionRef     String?
  status             String   @default("PENDING") // PENDING, APPROVED, DISBURSED, REJECTED
  approvedByUserId   String?
  approvedAt         DateTime?
  disbursedAt        DateTime?
  createdAt          DateTime @default(now())

  auction            Auction    @relation(fields: [auctionId], references: [id])
  subscriber         Subscriber @relation(fields: [subscriberId], references: [id])
  approvedBy         User?      @relation("ApprovedBy", fields: [approvedByUserId], references: [id])
}

model CashHandover {
  id                   String   @id @default(uuid())
  branchId             String
  staffUserId          String
  handoverDate         String   // YYYY-MM-DD
  expectedCash         Float
  actualCash           Float
  difference           Float    // actualCash - expectedCash
  status               String   @default("SUBMITTED") // SUBMITTED, VERIFIED, DISCREPANCY
  notes                String?
  verifiedByUserId     String?
  verifiedAt           DateTime?
  createdAt            DateTime @default(now())

  branch               Branch @relation(fields: [branchId], references: [id])
  staff                User   @relation("StaffHandover", fields: [staffUserId], references: [id])
  verifiedBy           User?  @relation("ManagerVerification", fields: [verifiedByUserId], references: [id])
}

model Expense {
  id           String   @id @default(uuid())
  branchId     String
  category     String   // RENT, UTILITIES, SALARY, TRAVEL, MISC
  amount       Float
  expenseDate  String   // YYYY-MM-DD
  description  String
  recordedBy   String
  createdAt    DateTime @default(now())

  branch       Branch   @relation(fields: [branchId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  details    String?  // JSON formatted details
  ipAddress  String?
  createdAt  DateTime @default(now())

  company    Company? @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
